{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Launch WebExtension",
        "type": "firefox",
        "request": "launch",
        "reAttach": true,
        "url": "https://s285-fr.ogame.gameforge.com/game/index.php?page=ingame&component=overview",
        "addonPath": "${workspaceFolder}/extension",
        "pathMappings": [
          {
            "url": "moz-extension://2ec818aa-f06c-4d88-b3eb-b2f7a86b5837",
            "path": "${workspaceFolder}/extension"
          }
        ]
      },
      {
        "name": "Attach WebExtension",
        "type": "firefox",
        "request": "attach",
        "addonPath": "${workspaceFolder}/extension",
        "pathMappings": [
          {
            "url": "moz-extension://4bd10861-d8e0-4b2e-a56f-b13da6ea3a67",
            "path": "${workspaceFolder}/extension"
          }
        ]
      }
    ]
}
